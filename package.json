{
  "name": "agentic-orchestra",
  "version": "0.4.0",
  "description": "One AI-agent toolkit for every coding CLI: 13 canonical agents, 10 skills incl. llm-sast-scanner, 12 provider adapters, multi-select installer.",
  "license": "BSL-1.0",
  "type": "module",
  "bin": {
    "agentic-orchestra": "./bin/agentic-orchestra.mjs"
  },
  "main": "./lib/convert.mjs",
  "exports": {
    ".": "./lib/convert.mjs",
    "./convert": "./lib/convert.mjs",
    "./frontmatter": "./lib/frontmatter.mjs",
    "./paths": "./lib/paths.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "core/",
    "skills/",
    ".agents/",
    "adapters/",
    "registry/",
    "installer/",
    "docs/",
    "install.sh",
    "install-opencode.sh",
    "install-claude.sh",
    "uninstall.sh",
    "verify.sh",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "skill": {
    "entry": "skills/sol-luna-orchestrator/SKILL.md",
    "references": "skills",
    "harnesses": [
      "omp",
      "opencode",
      "claude-code",
      "codex",
      "cursor",
      "gemini",
      "copilot",
      "qwen",
      "aider",
      "amp",
      "continue"
    ]
  },
  "scripts": {
    "verify": "./verify.sh",
    "verify:node": "node bin/agentic-orchestra.mjs verify",
    "verify:fast": "./verify.sh --fast",
    "test": "npm run verify:all",
    "verify:all": "npm run verify && npm run verify:node && node tests/evals/contract.mjs && node tests/evals/install-behavior.mjs && node tools/golden.mjs && node tools/check-spawn-graph.mjs",
    "golden:update": "node tools/golden.mjs --update",
    "eval:live": "node tests/evals/live.mjs --run"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dontworryplz/agentic-orchestra-.git"
  },
  "homepage": "https://github.com/dontworryplz/agentic-orchestra-#readme",
  "bugs": {
    "url": "https://github.com/dontworryplz/agentic-orchestra-/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "subagents",
    "skills",
    "opencode",
    "claude-code",
    "omp",
    "codex",
    "antigravity"
  ],
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
